{
 "schema_version": 1,
 "note": "인물 낭독 숏폼 편집 스타일의 시작값 모음. 좌표는 0~1 비율, 글자 크기는 1080x1920 기준 px. 글꼴 이름은 후보이며 학생 PC에 있는 글꼴(Pretendard 또는 맥 Apple SD Gothic Neo, 윈도우 Malgun Gothic)로 바꿔 쓴다. 학생 요청이 이 값보다 우선한다.",
 "series_headline": {
  "text": null,
  "duration_seconds": 2.0,
  "note": "학생의 시리즈 고정 문구. 비어 있으면 영상마다 학생과 정한다. 남의 시리즈 문구를 쓰지 않는다."
 },
 "common_rules": {
  "retakes": "버린 앞 시도·반복된 시작은 지우고 마지막으로 깔끔하게 끝낸 발화를 남긴다",
  "person_preservation": "얼굴 모양, 입 모양 타이밍, 손, 목소리를 바꾸지 않는다. 배경과 조명 보정은 학생이 허락한 범위에서만",
  "caption_overlap": "말 자막은 한 번에 하나만. 머리 위 제목과 말 자막은 다른 높이에 두고 글자 상자가 겹치지 않게",
  "caption_emphasis": "핵심어는 빨강 등 글자 색으로만 강조하고 배경 상자(알약·칩)는 쓰지 않는다",
  "camera_rhythm": "인물 화면의 확대·이동은 구절마다 다르게(짧은 확대, 천천히 밀기, 멈춤, 풀기). 일정한 간격으로 흔들지 않는다",
  "dialogue_rhythm": "말 사이 빈틈을 줄이고 늘어진 말끝만 줄여 문장이 바로 이어지게 한다. 배속으로 대신하지 않는다(모든 구간 1.0배)",
  "delivery": "MP4 + 고칠 수 있는 계획 파일 + 교정한 자막(SRT/ASS) + 쓴 자료 기록. 4K 납품은 1080x1920 기준본을 비율 유지로 키워 만들고 네이티브 4K 세부라고 말하지 않는다"
 },
